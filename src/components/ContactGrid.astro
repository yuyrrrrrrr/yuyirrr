---
import { site } from '../config/site';
---

<div class="contact-grid" id="contact">
  <a class="contact-card" href={`mailto:${site.email}`}>
    <span>
      <span>邮箱</span>
      <strong>{site.email}</strong>
    </span>
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
  </a>
  <a class="contact-card" href={site.github} target="_blank" rel="noreferrer">
    <span>
      <span>GitHub</span>
      <strong>@yuyrrrrrrr</strong>
    </span>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.3-.4 6.8-1.6 6.8-7A5.4 5.4 0 0 0 19.4 4 5 5 0 0 0 19.3.5S18.2.1 15 2a13.4 13.4 0 0 0-7 0C4.8.1 3.7.5 3.7.5A5 5 0 0 0 3.6 4a5.4 5.4 0 0 0-1.4 3.7c0 5.3 3.5 6.5 6.8 6.9A4.8 4.8 0 0 0 8 18v4"/><path d="M8 19c-3 .9-3-1.5-4-2"/></svg>
  </a>
  <a class="contact-card" href="/resume/">
    <span>
      <span>简历</span>
      <strong>在线版 + PDF</strong>
    </span>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h6"/></svg>
  </a>
</div>
