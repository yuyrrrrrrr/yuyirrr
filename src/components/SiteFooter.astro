---
import { site } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div>
        <span class="eyebrow">LET'S BUILD</span>
        <h2>有岗位或合作机会，<br />欢迎直接联系。</h2>
      </div>
      <div class="footer-links">
        <strong>站内</strong>
        <a href="/projects/">项目</a>
        <a href="/about/#resume">关于 / 简历</a>
        <a href="/blog/">博客/笔记</a>
      </div>
      <div class="footer-links">
        <strong>联系</strong>
        <button type="button" data-contact-trigger data-contact-option="Gmail">Gmail</button>
        <button type="button" data-contact-trigger data-contact-option="163 邮箱">163 邮箱</button>
        <button type="button" data-contact-trigger data-contact-option="GitHub">GitHub ↗</button>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} {site.name} · 个人作品集 · <a href="https://beian.miit.gov.cn/" target="_blank" rel="noreferrer">{site.icp}</a></span>
      <span>Astro · Static First</span>
    </div>
  </div>
</footer>
