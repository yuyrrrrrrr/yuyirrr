---
import type { ProjectEntry } from '../lib/content';
import { projectCategories } from '../config/taxonomy';
import { filmStills } from '../data/film';

interface Props {
  projects: ProjectEntry[];
}

const { projects } = Astro.props;
const pad = (value: number) => String(value).padStart(2, '0');
const lastIndex = Math.max(1, projects.length - 1);
---

<section class="film" data-film aria-labelledby="film-title">
  <div class="film__sticky">
    <header class="container film__head">
      <div class="film__heading">
        <span class="eyebrow">WORK / FEATURED</span>
        <h2 id="film-title">精选项目</h2>
      </div>
      <a class="text-link film__all" href="/projects/">查看全部项目 →</a>
    </header>

    <div
      class="film__viewport"
      data-film-viewport
      role="region"
      aria-roledescription="轮播"
      aria-label="精选项目作品带"
    >
      <ul class="film__track" data-film-track>
        {projects.map((project, index) => {
          const category = projectCategories[project.data.category];
          const still = filmStills[index % filmStills.length];
          const screen = project.data.gallery[0];
          return (
            <li
              class="film__frame"
              data-film-frame
              style={`--category-color:${category.color}`}
            >
              <a
                class="film__link"
                href={`/projects/${project.id}/`}
                data-film-open
                data-title={project.data.title}
                data-category={category.label}
                data-period={project.data.period}
                data-role={project.data.role}
                data-summary={project.data.summary}
                data-tech={project.data.tech.join(' · ')}
                data-cover={project.data.cover}
                data-screen={screen?.src ?? ''}
                data-screen-alt={screen?.alt ?? ''}
                data-demo={project.data.links.demo ?? ''}
                data-repo={project.data.links.repo ?? ''}
              >
                <span class="film__reel">
                  <span class="film__still">
                    <img
                      src={still.src}
                      alt={still.alt}
                      width={still.width}
                      height={still.height}
                      loading="lazy"
                      decoding="async"
                      draggable="false"
                    />
                  </span>
                  <span class="film__num" aria-hidden="true">{pad(index + 1)}</span>
                </span>
                <span class="film__caption">
                  <span class="film__title">{project.data.title}</span>
                  <span class="film__meta">
                    <span class="film__dot" aria-hidden="true"></span>
                    {category.label}
                    <span aria-hidden="true">·</span>
                    {project.data.period}
                  </span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>

    <div class="container film__hud">
      <p class="film__counter">
        <span data-film-count>{pad(1)}</span>
        <span class="film__counter-total">/ {pad(projects.length)}</span>
      </p>
      <div class="film__progress">
        <span class="film__progress-fill" aria-hidden="true"></span>
        {projects.map((project, index) => (
          <button
            class="film__tick"
            type="button"
            data-film-tick
            data-index={index}
            aria-label={`第 ${index + 1} 个作品：${project.data.title}`}
            aria-current={index === 0 ? 'true' : 'false'}
            style={`--tick:${(index / lastIndex) * 100}%`}
          >
            <span class="sr-only">{`${pad(index + 1)} / ${pad(projects.length)}`}</span>
          </button>
        ))}
      </div>
      <p class="film__hint" aria-hidden="true">滚轮 · 拖动 · ← →</p>
    </div>

    <div class="film__nav">
      <button class="film__nav-btn" type="button" data-film-prev aria-label="上一个作品">
        <span aria-hidden="true">←</span>
      </button>
      <button class="film__nav-btn" type="button" data-film-next aria-label="下一个作品">
        <span aria-hidden="true">→</span>
      </button>
    </div>
  </div>

  <dialog class="project-dialog" data-film-dialog aria-labelledby="film-dialog-title">
    <button class="project-dialog__close" type="button" data-film-close aria-label="关闭项目详情">
      <span aria-hidden="true">✕</span>
    </button>
    <div class="project-dialog__inner">
      <div class="project-dialog__media">
        <div class="project-dialog__visual">
          <img data-film-cover alt="" width="1200" height="760" />
        </div>
        <figure class="project-dialog__screen" data-film-screen-wrap hidden>
          <img data-film-screen alt="" width="1440" height="900" loading="lazy" decoding="async" />
          <figcaption data-film-screen-caption></figcaption>
        </figure>
      </div>
      <div class="project-dialog__body">
        <span class="eyebrow">PROJECT <span data-film-num></span></span>
        <h2 id="film-dialog-title" data-film-title></h2>
        <p class="project-dialog__summary" data-film-summary></p>
        <dl class="project-dialog__meta">
          <div><dt>类别</dt><dd data-film-category></dd></div>
          <div><dt>时间</dt><dd data-film-period></dd></div>
          <div><dt>角色</dt><dd data-film-role></dd></div>
        </dl>
        <div class="project-dialog__tech" data-film-tech></div>
        <div class="project-dialog__actions">
          <a class="button button--accent" data-film-detail href="/projects/">查看完整案例 →</a>
          <a class="button button--ghost" data-film-demo href="#" target="_blank" rel="noreferrer" hidden>在线 Demo ↗</a>
          <a class="button button--ghost" data-film-repo href="#" target="_blank" rel="noreferrer" hidden>代码仓库 ↗</a>
        </div>
      </div>
    </div>
  </dialog>
</section>

<script>
  const section = document.querySelector<HTMLElement>('[data-film]');

  if (section) {
    const viewport = section.querySelector<HTMLElement>('[data-film-viewport]');
    const track = section.querySelector<HTMLElement>('[data-film-track]');
    const frames = Array.from(section.querySelectorAll<HTMLElement>('[data-film-frame]'));
    const count = section.querySelector<HTMLElement>('[data-film-count]');
    const ticks = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-film-tick]'));
    const prevButton = section.querySelector<HTMLButtonElement>('[data-film-prev]');
    const nextButton = section.querySelector<HTMLButtonElement>('[data-film-next]');
    const dialog = section.querySelector<HTMLDialogElement>('[data-film-dialog]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const narrow = window.matchMedia('(max-width: 720px)');
    const pad = (value: number) => String(value).padStart(2, '0');

    let pinned = false;
    let distance = 0;
    let frameCenters: number[] = [];
    let activeIndex = -1;
    let ticking = false;
    let dragging = false;
    let suppressClick = false;
    let suppressFocusScroll = false;
    let opener: HTMLElement | null = null;
    let dragPointer: number | null = null;
    let dragStartX = 0;
    let dragLastX = 0;

    const clamp = (value: number, min: number, max: number) =>
      Math.min(max, Math.max(min, value));

    const scrollInstant = (top: number) => {
      const root = document.documentElement;
      const previous = root.style.scrollBehavior;
      root.style.scrollBehavior = 'auto';
      window.scrollTo(0, top);
      root.style.scrollBehavior = previous;
    };

    const setActive = (index: number) => {
      if (index === activeIndex) return;
      activeIndex = index;

      if (count) count.textContent = pad(index + 1);
      frames.forEach((frame, frameIndex) => {
        const isActive = frameIndex === index;
        frame.classList.toggle('is-active', isActive);
        const link = frame.querySelector<HTMLAnchorElement>('[data-film-open]');
        if (link) {
          if (isActive) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        }
      });
      ticks.forEach((tick, tickIndex) => {
        tick.setAttribute('aria-current', tickIndex === index ? 'true' : 'false');
      });
      if (prevButton) prevButton.disabled = index <= 0;
      if (nextButton) nextButton.disabled = index >= frames.length - 1;
    };

    const update = () => {
      ticking = false;
      if (!pinned || !track || !viewport || distance <= 0) return;

      const progress = clamp(-section.getBoundingClientRect().top / distance, 0, 1);
      const width = viewport.clientWidth;
      const focusX = progress * distance + width / 2;
      let nearest = 0;
      let best = Number.POSITIVE_INFINITY;

      track.style.transform = `translate3d(${-progress * distance}px, 0, 0)`;
      section.style.setProperty('--p', progress.toFixed(4));

      frameCenters.forEach((center, index) => {
        const frame = frames[index];
        const offset = center - focusX;
        const delta = Math.abs(offset);
        if (delta < best) {
          best = delta;
          nearest = index;
        }

        const t = clamp(offset / (width * 0.52), -1.8, 1.8);
        const abs = Math.abs(t);
        const focus = clamp(1 - abs * 1.15, 0, 1);

        frame.style.setProperty('--ry', `${clamp(-t * 24, -32, 32).toFixed(2)}deg`);
        frame.style.setProperty('--tz', `${(-abs * 190).toFixed(1)}px`);
        frame.style.setProperty('--s', (1 - abs * 0.11).toFixed(3));
        frame.style.setProperty('--focus', focus.toFixed(3));
      });

      setActive(nearest);
    };

    const updateRail = () => {
      if (pinned || !viewport) return;
      const width = viewport.clientWidth;
      const max = viewport.scrollWidth - width;
      const progress = max > 0 ? clamp(viewport.scrollLeft / max, 0, 1) : 0;

      section.style.setProperty('--p', progress.toFixed(4));

      const viewRect = viewport.getBoundingClientRect();
      const centerX = viewRect.left + width / 2;
      let nearest = 0;
      let best = Number.POSITIVE_INFINITY;
      frames.forEach((frame, index) => {
        const rect = frame.getBoundingClientRect();
        const delta = Math.abs(rect.left + rect.width / 2 - centerX);
        if (delta < best) {
          best = delta;
          nearest = index;
        }
      });
      setActive(nearest);
    };

    const requestUpdate = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    const layout = () => {
      if (!track || !viewport) return;

      pinned = !reduceMotion.matches && !narrow.matches && viewport.clientWidth > 0;

      if (!pinned) {
        section.removeAttribute('data-pinned');
        section.style.removeProperty('--film-distance');
        track.style.transform = '';
        frames.forEach((frame) => {
          frame.style.removeProperty('--ry');
          frame.style.removeProperty('--tz');
          frame.style.removeProperty('--s');
          frame.style.removeProperty('--focus');
        });
        activeIndex = -1;
        updateRail();
        return;
      }

      section.setAttribute('data-pinned', 'true');
      distance = Math.max(0, track.scrollWidth - viewport.clientWidth);
      section.style.setProperty('--film-distance', `${distance}px`);
      frameCenters = frames.map((frame) => frame.offsetLeft + frame.offsetWidth / 2);
      update();
    };

    const goTo = (index: number, behavior: ScrollBehavior = 'smooth') => {
      if (!viewport) return;
      const target = clamp(index, 0, frames.length - 1);

      if (pinned && distance > 0) {
        const center = frameCenters[target] ?? 0;
        const progress = clamp((center - viewport.clientWidth / 2) / distance, 0, 1);
        const top = window.scrollY + section.getBoundingClientRect().top + progress * distance;
        window.scrollTo({ top, behavior });
      } else {
        const frame = frames[target];
        const left = frame.offsetLeft - (viewport.clientWidth - frame.offsetWidth) / 2;
        viewport.scrollTo({ left, behavior });
      }
    };

    window.addEventListener('scroll', () => {
      if (pinned) requestUpdate();
    }, { passive: true });

    viewport?.addEventListener('scroll', () => {
      if (!pinned) updateRail();
    }, { passive: true });

    window.addEventListener('resize', layout);
    reduceMotion.addEventListener('change', layout);
    narrow.addEventListener('change', layout);

    prevButton?.addEventListener('click', () => goTo(activeIndex - 1));
    nextButton?.addEventListener('click', () => goTo(activeIndex + 1));

    ticks.forEach((tick) => {
      tick.addEventListener('click', () => {
        goTo(Number(tick.dataset.index ?? '0'));
      });
    });

    section.addEventListener('keydown', (event) => {
      if (dialog?.open || event.defaultPrevented || event.metaKey || event.ctrlKey || event.altKey) {
        return;
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        goTo(activeIndex + 1);
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        goTo(activeIndex - 1);
      } else if (event.key === 'Home') {
        event.preventDefault();
        goTo(0);
      } else if (event.key === 'End') {
        event.preventDefault();
        goTo(frames.length - 1);
      }
    });

    section.addEventListener('focusin', (event) => {
      if (suppressFocusScroll || !(event.target instanceof Element)) return;
      const frame = event.target.closest<HTMLElement>('[data-film-frame]');
      if (!frame) return;
      const target = event.target as HTMLElement;
      if (!target.matches(':focus-visible')) return;

      const index = frames.indexOf(frame);
      if (index < 0) return;

      if (pinned) {
        goTo(index);
      } else {
        frame.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      }
    });

    if (viewport) {
      viewport.addEventListener('dragstart', (event) => event.preventDefault());

      viewport.addEventListener('pointerdown', (event) => {
        if (!pinned || event.pointerType === 'touch' || event.button !== 0) return;
        dragging = false;
        dragPointer = event.pointerId;
        dragStartX = event.clientX;
        dragLastX = event.clientX;
      });

      viewport.addEventListener('pointermove', (event) => {
        if (dragPointer !== event.pointerId) return;

        if (!dragging && Math.abs(event.clientX - dragStartX) > 5) {
          dragging = true;
          viewport.setPointerCapture(event.pointerId);
          section.classList.add('is-dragging');
        }
        if (!dragging) return;

        const delta = event.clientX - dragLastX;
        dragLastX = event.clientX;
        if (delta !== 0) {
          scrollInstant(window.scrollY - delta);
          event.preventDefault();
        }
      });

      const endDrag = (event: PointerEvent) => {
        if (dragPointer !== event.pointerId) return;
        dragPointer = null;
        if (viewport.hasPointerCapture(event.pointerId)) {
          viewport.releasePointerCapture(event.pointerId);
        }
        section.classList.remove('is-dragging');
        if (dragging) {
          suppressClick = true;
          window.setTimeout(() => {
            suppressClick = false;
          }, 0);
        }
        dragging = false;
      };

      viewport.addEventListener('pointerup', endDrag);
      viewport.addEventListener('pointercancel', endDrag);
    }

    const setText = (name: string, value: string) => {
      const node = dialog?.querySelector<HTMLElement>(`[data-film-${name}]`);
      if (node) node.textContent = value;
    };

    const openDialog = (link: HTMLAnchorElement) => {
      if (!dialog) return;
      const data = link.dataset;

      setText('title', data.title ?? '');
      setText('summary', data.summary ?? '');
      setText('category', data.category ?? '');
      setText('period', data.period ?? '');
      setText('role', data.role ?? '');
      setText('screen-caption', data.screenAlt ?? '');

      const cover = dialog.querySelector<HTMLImageElement>('[data-film-cover]');
      if (cover) {
        cover.src = data.cover ?? '';
        cover.alt = `${data.title ?? ''}封面`;
      }

      const screenWrap = dialog.querySelector<HTMLElement>('[data-film-screen-wrap]');
      const screen = dialog.querySelector<HTMLImageElement>('[data-film-screen]');
      if (screenWrap && screen) {
        const hasScreen = Boolean(data.screen);
        screenWrap.hidden = !hasScreen;
        if (hasScreen) {
          screen.src = data.screen ?? '';
          screen.alt = data.screenAlt ?? '';
        } else {
          screen.removeAttribute('src');
        }
      }

      const tech = dialog.querySelector<HTMLElement>('[data-film-tech]');
      if (tech) {
        tech.replaceChildren(
          ...(data.tech ?? '')
            .split(' · ')
            .filter(Boolean)
            .map((item) => {
              const chip = document.createElement('span');
              chip.textContent = item;
              return chip;
            })
        );
      }

      const detail = dialog.querySelector<HTMLAnchorElement>('[data-film-detail]');
      if (detail) detail.href = link.getAttribute('href') ?? '/projects/';

      const syncLink = (name: 'demo' | 'repo', url: string | undefined) => {
        const anchor = dialog.querySelector<HTMLAnchorElement>(`[data-film-${name}]`);
        if (!anchor) return;
        anchor.hidden = !url;
        if (url) anchor.href = url;
        else anchor.removeAttribute('href');
      };
      syncLink('demo', data.demo);
      syncLink('repo', data.repo);

      const index = frames.findIndex((frame) => frame.contains(link));
      setText('num', index >= 0 ? `${pad(index + 1)} / ${pad(frames.length)}` : '');

      opener = link;
      const scrollbar = window.innerWidth - document.documentElement.clientWidth;
      document.documentElement.style.setProperty('--dialog-scrollbar', `${scrollbar}px`);
      document.documentElement.classList.add('is-dialog-open');
      dialog.showModal();
    };

    const closeDialog = () => dialog?.close();

    dialog?.querySelector('[data-film-close]')?.addEventListener('click', closeDialog);

    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) closeDialog();
    });

    dialog?.addEventListener('close', () => {
      document.documentElement.classList.remove('is-dialog-open');
      document.documentElement.style.removeProperty('--dialog-scrollbar');
      if (!opener) return;
      suppressFocusScroll = true;
      opener.focus({ preventScroll: true });
      window.setTimeout(() => {
        suppressFocusScroll = false;
      }, 0);
      opener = null;
    });

    frames.forEach((frame) => {
      const link = frame.querySelector<HTMLAnchorElement>('[data-film-open]');
      if (!link) return;
      link.addEventListener('click', (event) => {
        if (suppressClick) {
          event.preventDefault();
          suppressClick = false;
          return;
        }
        if (
          event.defaultPrevented ||
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        ) {
          return;
        }
        if (!dialog || typeof dialog.showModal !== 'function') return;

        event.preventDefault();
        openDialog(link);
      });
    });

    section.setAttribute('data-enhanced', 'true');
    layout();
  }
</script>
