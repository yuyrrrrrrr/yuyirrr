---
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const navItems = [
  { href: '/', label: '首页', match: '/' },
  { href: '/projects/', label: '项目', match: '/projects' },
  { href: '/blog/', label: '博客/笔记', match: '/blog' },
  { href: '/about/', label: '关于', match: '/about' }
];
const isActive = (match: string) => match === '/' ? currentPath === '/' : currentPath.startsWith(match);
---

<header class="site-header">
  <div class="container site-header__bar">
    <a class="brand" href="/" aria-label="yuyirrr 首页">
      <img
        class="brand__signature"
        src="/images/signature-nbw.png"
        width="375"
        height="240"
        alt=""
        aria-hidden="true"
        decoding="async"
      />
    </a>
    <nav class="nav" aria-label="主导航">
      {navItems.map((item) => (
        <a href={item.href} aria-current={isActive(item.match) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <button class="button button--primary header-cta" type="button" data-contact-trigger>联系我</button>
    <details class="mobile-nav">
      <summary>导航菜单</summary>
      <nav aria-label="移动端导航">
        {navItems.map((item) => (
          <a href={item.href} aria-current={isActive(item.match) ? 'page' : undefined}>{item.label}</a>
        ))}
        <button type="button" data-contact-trigger>联系我</button>
      </nav>
    </details>
  </div>
</header>
