---
import { signaturePath, signatureViewBox } from '../data/signature';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const navItems = [
  { href: '/', label: '首页', match: '/' },
  { href: '/projects/', label: '项目', match: '/projects' },
  { href: '/resume/', label: '简历', match: '/resume' },
  { href: '/blog/', label: '博客/笔记', match: '/blog' },
  { href: '/about/', label: '关于', match: '/about' }
];
const isActive = (match: string) => match === '/' ? currentPath === '/' : currentPath.startsWith(match);
---

<header class="site-header">
  <div class="container site-header__bar">
    <a class="brand" href="/" aria-label="yuyirrr 首页">
      <svg
        class="brand__signature"
        viewBox={signatureViewBox}
        aria-hidden="true"
        focusable="false"
      >
        <defs>
          <linearGradient
            id="brand-signature"
            x1="42"
            y1="0"
            x2="1398"
            y2="0"
            gradientUnits="userSpaceOnUse"
          >
            <stop offset="0" stop-color="#d9a05b"></stop>
            <stop offset="0.35" stop-color="#b9a35f"></stop>
            <stop offset="0.62" stop-color="#8a9a6f"></stop>
            <stop offset="1" stop-color="#5a9a7a"></stop>
          </linearGradient>
        </defs>
        <path
          d={signaturePath}
          fill="none"
          stroke="url(#brand-signature)"
          stroke-width="46"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
      </svg>
    </a>
    <nav class="nav" aria-label="主导航">
      {navItems.map((item) => (
        <a href={item.href} aria-current={isActive(item.match) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <a class="button button--primary header-cta" href="/about/#contact">联系我</a>
    <details class="mobile-nav">
      <summary>导航菜单</summary>
      <nav aria-label="移动端导航">
        {navItems.map((item) => (
          <a href={item.href} aria-current={isActive(item.match) ? 'page' : undefined}>{item.label}</a>
        ))}
        <a href="/about/#contact">联系我</a>
      </nav>
    </details>
  </div>
</header>
