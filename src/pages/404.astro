---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到" noindex>
  <section class="not-found">
    <div class="container">
      <span class="eyebrow">404 / NOT FOUND</span>
      <h1>404</h1>
      <h2>这条路径暂时不存在。</h2>
      <p>可能是链接已经更新，或地址输入有误。可以从首页重新开始，也可以直接查看项目。</p>
      <div class="button-row" style="justify-content:center">
        <a class="button button--primary" href="/">返回首页</a>
        <a class="button button--ghost" href="/projects/">查看项目</a>
      </div>
    </div>
  </section>
</BaseLayout>
