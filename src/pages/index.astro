---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GravityHero from '../components/GravityHero.astro';
import FilmGallery from '../components/FilmGallery.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BlogCard from '../components/BlogCard.astro';
import ContactGrid from '../components/ContactGrid.astro';
import { techGroups } from '../config/site';
import { sortPosts, sortProjects } from '../lib/content';

const projects = sortProjects((await getCollection('projects')).filter((project) => !project.data.draft));
const posts = sortPosts((await getCollection('blog')).filter((post) => !post.data.draft)).slice(0, 3);
---

<BaseLayout theme="stage">
  <GravityHero />

  <section class="section toolkit" aria-labelledby="toolkit-title">
    <div class="container">
      <SectionHeading eyebrow="TOOLKIT" title="技术栈" id="toolkit-title" />
      <div class="toolkit__grid">
        {techGroups.map((group, index) => (
          <article class="toolkit__group">
            <span class="toolkit__index">0{index + 1}</span>
            <h3>{group.label}</h3>
            <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <FilmGallery projects={projects} />

  <section class="section notes" aria-labelledby="notes-title">
    <div class="container">
      <SectionHeading
        eyebrow="NOTES"
        title="笔记"
        id="notes-title"
        actionHref="/blog/"
        actionLabel="阅读全部笔记"
      />
      <div class="blog-grid">
        {posts.map((post) => <BlogCard post={post} />)}
      </div>
    </div>
  </section>

  <section class="section contact" aria-labelledby="contact-title">
    <div class="container">
      <SectionHeading eyebrow="CONTACT" title="联系" id="contact-title" />
      <ContactGrid />
    </div>
  </section>
</BaseLayout>
