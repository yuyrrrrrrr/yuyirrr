---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import Tag from '../../components/Tag.astro';
import { site } from '../../config/site';
import { sortProjects } from '../../lib/content';

type Project = CollectionEntry<'projects'>;

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).filter((project) => !project.data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project }
  }));
}

interface Props { project: Project }
const { project } = Astro.props;
const allProjects = sortProjects((await getCollection('projects')).filter((item) => !item.data.draft));
const currentIndex = allProjects.findIndex((item) => item.id === project.id);
const previous = currentIndex > 0 ? allProjects[currentIndex - 1] : allProjects.at(-1);
const next = currentIndex < allProjects.length - 1 ? allProjects[currentIndex + 1] : allProjects[0];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.data.title,
  description: project.data.summary,
  dateCreated: project.data.publishedAt.toISOString().slice(0, 10),
  creator: { '@type': 'Person', name: site.name, url: site.siteUrl },
  keywords: project.data.tech.join(', '),
  url: new URL(`/projects/${project.id}/`, site.siteUrl).toString()
};
---

<BaseLayout
  title={project.data.title}
  description={`${project.data.summary}${project.data.isSample ? '（示例项目）' : ''}`}
  image={project.data.cover}
  type="article"
  jsonLd={jsonLd}
>
  <article>
    <header class="project-detail-hero">
      <div class="container">
        <ol class="breadcrumb">
          <li><a href="/">首页</a></li>
          <li><a href="/projects/">项目</a></li>
          <li>{project.data.title}</li>
        </ol>
        <div class="project-detail-hero__grid">
          <div>
            <div class="button-row" style="margin-bottom:1rem">
              <CategoryBadge category={project.data.category} />
              {project.data.isSample && <span class="pill sample-badge">示例内容 · 待替换</span>}
            </div>
            <h1>{project.data.title}</h1>
            <p class="project-detail-hero__summary">{project.data.summary}</p>
            <dl class="project-meta">
              <div><dt>角色</dt><dd>{project.data.role}</dd></div>
              <div><dt>时间</dt><dd>{project.data.period}</dd></div>
            </dl>
            <div class="button-row" style="margin-top:1.6rem">
              {project.data.links.demo && <a class="button button--accent" href={project.data.links.demo} target="_blank" rel="noreferrer">查看 Demo ↗</a>}
              {project.data.links.repo && <a class="button button--ghost" href={project.data.links.repo} target="_blank" rel="noreferrer">代码仓库 ↗</a>}
            </div>
          </div>
          <figure class="project-cover">
            <img src={project.data.cover} alt={`${project.data.title}封面`} width="1200" height="760" />
          </figure>
        </div>
      </div>
    </header>

    <section class="detail-section" id="problem">
      <div class="container detail-section__grid">
        <div class="detail-section__title"><span class="eyebrow">01 / PROBLEM</span><h2>一句话</h2></div>
        <div class="prose"><p>{project.data.problem}</p></div>
      </div>
    </section>

    <section class="detail-section" id="background">
      <div class="container detail-section__grid">
        <div class="detail-section__title"><span class="eyebrow">02 / CONTEXT</span><h2>背景与目标</h2></div>
        <div class="prose">
          <p>{project.data.background}</p>
          <ul class="check-list">{project.data.goals.map((goal) => <li>{goal}</li>)}</ul>
        </div>
      </div>
    </section>

    <section class="detail-section" id="role">
      <div class="container detail-section__grid">
        <div class="detail-section__title"><span class="eyebrow">03 / ROLE</span><h2>我的角色</h2></div>
        <div class="prose">
          <p>{project.data.role}</p>
          <ol class="number-list">{project.data.responsibilities.map((item) => <li>{item}</li>)}</ol>
        </div>
      </div>
    </section>

    <section class="detail-section" id="stack">
      <div class="container detail-section__grid">
        <div class="detail-section__title"><span class="eyebrow">04 / STACK</span><h2>技术栈</h2></div>
        <div class="prose">
          <div class="tag-list">{project.data.tech.map((item) => <Tag label={item} />)}</div>
        </div>
      </div>
    </section>

    <section class="detail-section" id="architecture">
      <div class="container detail-section__grid">
        <div class="detail-section__title"><span class="eyebrow">05 / SYSTEM</span><h2>架构图 / 数据流</h2></div>
        <div class="prose">
          <p>{project.data.architecture.description}</p>
          <figure class="architecture-figure">
            <img src={project.data.architecture.image} alt={project.data.architecture.caption} width="1200" height="720" loading="lazy" decoding="async" />
            <figcaption>{project.data.architecture.caption}</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="detail-section" id="features">
      <div class="container detail-section__grid">
        <div class="detail-section__title"><span class="eyebrow">06 / FEATURES</span><h2>核心功能</h2></div>
        <div class="prose">
          <div class="stack-list">
            {project.data.features.map((feature) => (
              <article class="stack-item"><h3>{feature.title}</h3><p>{feature.description}</p></article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="detail-section" id="challenges">
      <div class="container detail-section__grid">
        <div class="detail-section__title"><span class="eyebrow">07 / TRADE-OFFS</span><h2>难点与解决方案</h2></div>
        <div class="prose">
          <div class="stack-list">
            {project.data.challenges.map((challenge) => (
              <article class="stack-item"><h3>{challenge.title}</h3><p>{challenge.solution}</p></article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="detail-section" id="results">
      <div class="container detail-section__grid">
        <div class="detail-section__title"><span class="eyebrow">08 / OUTCOME</span><h2>结果</h2></div>
        <div class="prose">
          <p>{project.data.resultsSummary}</p>
          <div class="metric-grid">
            {project.data.metrics.map((metric) => (
              <div class="metric-card"><strong>{metric.value}</strong><span>{metric.label}</span>{metric.note && <small>{metric.note}</small>}</div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {project.data.gallery.length > 0 && (
      <section class="detail-section" id="gallery">
        <div class="container detail-section__grid">
          <div class="detail-section__title"><span class="eyebrow">09 / SCREENS</span><h2>截图或 GIF</h2></div>
          <div class="gallery">
            {project.data.gallery.map((image) => (
              <figure class="screenshot-figure">
                <img src={image.src} alt={image.alt} width="1440" height="900" loading="lazy" decoding="async" />
                <figcaption>{image.alt}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="detail-section" id="links">
      <div class="container detail-section__grid">
        <div class="detail-section__title"><span class="eyebrow">10 / LINKS</span><h2>Demo / 代码仓库</h2></div>
        <div class="prose">
          <div class="button-row">
            {project.data.links.demo ? <a class="button button--accent" href={project.data.links.demo} target="_blank" rel="noreferrer">在线 Demo ↗</a> : <span class="pill">Demo 暂未公开</span>}
            {project.data.links.repo ? <a class="button button--ghost" href={project.data.links.repo} target="_blank" rel="noreferrer">GitHub 仓库 ↗</a> : <span class="pill">仓库暂未公开</span>}
          </div>
        </div>
      </div>
    </section>

    <section class="detail-section" id="reflection">
      <div class="container detail-section__grid">
        <div class="detail-section__title"><span class="eyebrow">11 / RETROSPECTIVE</span><h2>复盘</h2></div>
        <div class="prose"><p>{project.data.reflection}</p></div>
      </div>
    </section>

    <nav class="container project-pagination" aria-label="项目翻页">
      {previous && <a class="pagination-link" href={`/projects/${previous.id}/`}><span>上一个项目</span><strong>← {previous.data.title}</strong></a>}
      {next && <a class="pagination-link pagination-link--next" href={`/projects/${next.id}/`}><span>下一个项目</span><strong>{next.data.title} →</strong></a>}
    </nav>
  </article>
</BaseLayout>

